generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model artists {
  id        String     @id @db.VarChar(50)
  name      String     @db.VarChar(255)
  bio       String?
  photo_url String?
  category  String?    @db.VarChar(100)
  lifespan  String?    @db.VarChar(100)
  artworks  artworks[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model artworks {
  id          String   @id @db.VarChar(50)
  artist_id   String?  @db.VarChar(50)
  title       String   @db.VarChar(255)
  date        String?  @db.VarChar(100)
  category    String?  @db.VarChar(100)
  medium      String?  @db.VarChar(255)
  description String?
  remote_url  String
  largura     Int
  altura      Int
  artists     artists? @relation(fields: [artist_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
